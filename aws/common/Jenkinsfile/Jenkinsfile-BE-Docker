pipeline {
  // 🐳 Docker 빌드를 위한 Kubernetes 에이전트 사용
  agent {
    label 'docker'
  }

  environment {
    PROJECT_NAME     = "pumati"
    SERVICE_NAME     = "backend"
    S3_BUCKET        = "s3-pumati-common-storage"
    AWS_REGION       = "ap-northeast-2"
    
    // 🐳 Docker 관련 환경 변수
    ECR_REGISTRY     = "236450698266.dkr.ecr.ap-northeast-2.amazonaws.com"
    ECR_REPOSITORY   = "pumati-dev-backend-ecr"
    DOCKER_BUILDKIT  = "1"
  }

  stages {
    stage('Set Branch & Environment') {
      steps {
        script {
          // 1. Git 브랜치명 추출 (origin/ 접두사 제거)
          def branchName = (env.BRANCH_NAME ?: env.GIT_BRANCH)?.replaceFirst(/^origin\//, '') ?: 'unknown'
          env.BRANCH = branchName

          // 2. 브랜치에 따라 ENV_LABEL 및 트리거 설정
          if (branchName == 'main') {
            env.ENV_LABEL = 'prod'
            properties([
              pipelineTriggers([
                cron('0 9 * * *')  // prod는 매일 9시에 자동 실행
              ])
            ])
          } else if (branchName == 'dev') {
            env.ENV_LABEL = 'dev'
            properties([])  // 자동 트리거 없음 (수동/웹훅만)
          } else {
            env.ENV_LABEL = 'unknown'
            properties([pipelineTriggers([])])  // 트리거 초기화
            echo "지원되지 않는 브랜치입니다: ${branchName}. 빌드를 중단합니다."
            currentBuild.result = 'NOT_BUILT'
            error("Unsupported branch: ${branchName}")
          }

          // 3. Docker 이미지 태그 생성
          def shortHash = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
          env.IMAGE_TAG = "${env.BUILD_NUMBER}-${shortHash}"
          env.FULL_IMAGE_NAME = "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.IMAGE_TAG}"

          // 4. 설정 확인 로그
          echo "현재 브랜치: ${env.BRANCH}"
          echo "설정된 ENV_LABEL: ${env.ENV_LABEL}"
          echo "Docker 이미지 태그: ${env.IMAGE_TAG}"
          echo "전체 이미지 이름: ${env.FULL_IMAGE_NAME}"
        }
      }
    }

    stage('Notify Before Start') {
      when {
          expression { env.BRANCH in ['main', 'dev'] }
      }
      steps {
        script {
          def service = env.SERVICE_NAME ?: '알 수 없는 서비스'
          try {
            withCredentials([string(credentialsId: 'Discord-Webhook', variable: 'DISCORD')]) {
              discordSend(
                description: "🐳 Docker 빌드 배포가 곧 시작됩니다: ${service} - ${env.BRANCH} 브랜치",
                link: env.BUILD_URL,
                title: "Docker 빌드 배포 시작",
                webhookURL: DISCORD
              )
            }
          } catch (e) {
            echo "디스코드 알림 전송 실패: ${e.message}"
          }
        }
      }
    }

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Fetch .env from AWS Secrets Manager') {
      steps {
        script {
          try {
            // 1. Secrets Manager에서 .env 내용 가져오기
            def secret = sh(
              script: """
                aws secretsmanager get-secret-value \
                  --secret-id ${env.PROJECT_NAME}-${env.ENV_LABEL}-${env.SERVICE_NAME}-.env \
                  --region ${env.AWS_REGION} \
                  --query SecretString \
                  --output text
              """,
              returnStdout: true
            ).trim()

            // 2. .env 파일로 저장
            writeFile file: '.env', text: secret

            // 3. 보안 강화를 위한 퍼미션 제한
            sh 'chmod 600 .env'

            echo "✅ .env 파일 로딩 완료"
          } catch (e) {
            echo ".env 시크릿 로딩 실패: ${e.message}"
            currentBuild.result = 'FAILURE'
            error("빌드 중단: Secrets Manager에서 .env를 불러올 수 없습니다.")
          }
        }
      }
    }

    stage('Build Application') {
      steps {
        script {
          echo "🏗️ Gradle 빌드 시작"
          sh './gradlew clean build -x test'
          
          // JAR 파일 존재 확인
          def jarFile = sh(
            script: "find build/libs -type f -name '*.jar' | sort | tail -n 1",
            returnStdout: true
          ).trim()

          if (!jarFile) {
            error "JAR 파일이 존재하지 않습니다. 빌드 실패"
          }
          
          echo "✅ JAR 파일 생성 완료: ${jarFile}"
        }
      }
    }

    stage('Build Docker Image') {
      steps {
        script {
          echo "🐳 Docker 이미지 빌드 시작"
          
          // Docker 환경 확인
          sh '''
            echo "=== Docker 환경 확인 ==="
            docker --version
            docker info
            echo "DOCKER_HOST: ${DOCKER_HOST}"
            echo "DOCKER_TLS_VERIFY: ${DOCKER_TLS_VERIFY}"
            echo "DOCKER_CERT_PATH: ${DOCKER_CERT_PATH}"
          '''
          
          // Docker 이미지 빌드
          sh """
            docker build \
              -f ci/dev/Dockerfile \
              -t ${env.FULL_IMAGE_NAME} \
              -t ${env.ECR_REPOSITORY}:latest \
              --build-arg BUILD_DATE=\$(date -u +'%Y-%m-%dT%H:%M:%SZ') \
              --build-arg VCS_REF=${env.GIT_COMMIT_SHORT} \
              --build-arg VERSION=${env.IMAGE_TAG} \
              .
          """
          
          echo "✅ Docker 이미지 빌드 완료: ${env.FULL_IMAGE_NAME}"
        }
      }
    }

    stage('Security Scan') {
      steps {
        script {
          echo "🔍 보안 스캔 실행"
          
          // Trivy를 사용한 취약점 스캔 (실패해도 파이프라인 중단하지 않음)
          sh """
            trivy image --format json --output trivy-report.json ${env.FULL_IMAGE_NAME} || echo "Trivy 스캔 완료 (경고 포함)"
          """
        }
      }
      
      post {
        always {
          // 보안 스캔 결과 저장
          archiveArtifacts artifacts: 'trivy-report.json', allowEmptyArchive: true
        }
      }
    }

    stage('Push Docker Image') {
      steps {
        script {
          echo "🚀 Docker 이미지 ECR 푸시 시작"
          
          // AWS ECR 로그인
          sh """
            aws ecr get-login-password --region ${env.AWS_REGION} | \\
            docker login --username AWS --password-stdin ${env.ECR_REGISTRY}
          """
          
          // 이미지 푸시
          sh "docker push ${env.FULL_IMAGE_NAME}"
          
          // latest 태그도 푸시
          sh """
            docker tag ${env.FULL_IMAGE_NAME} ${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:latest
            docker push ${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:latest
          """
          
          echo "✅ Docker 이미지 ECR 푸시 완료"
        }
      }
    }

    stage('Archive & Upload JAR to S3') {
      steps {
        script {
          // 1. JAR 파일 찾기
          def jarFile = sh(
            script: "find build/libs -type f -name '*.jar' | sort | tail -n 1",
            returnStdout: true
          ).trim()

          if (!jarFile) {
            error "JAR 파일이 존재하지 않습니다. 빌드 실패"
          }

          // 2. 타임스탬프 및 커밋 해시로 파일 이름 생성
          def timestamp = new Date().format("yyyyMMdd-HHmmss", TimeZone.getTimeZone('Asia/Seoul'))
          def shortHash = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
          env.BUILD_FILE = "output-${timestamp}-${shortHash}.zip"

          // 3. 압축 + S3 업로드
          echo "압축 대상: ${jarFile}"
          sh """
            zip -j ${env.BUILD_FILE} ${jarFile}
            echo "✅ 압축 완료: ${env.BUILD_FILE}"

            aws s3 cp ${env.BUILD_FILE} s3://${env.S3_BUCKET}/CI/${env.ENV_LABEL}/${env.SERVICE_NAME}/${env.BUILD_FILE} \
              --region ${env.AWS_REGION}

            echo "✅ S3 업로드 완료: s3://${env.S3_BUCKET}/CI/${env.ENV_LABEL}/${env.SERVICE_NAME}/${env.BUILD_FILE}"
          """
        }
      }
    }
  }

  post {
    always {
      echo '🧹 빌드 정리 작업 시작'
      
      // Docker 이미지 정리 (로컬 캐시 정리)
      sh """
        docker rmi ${env.FULL_IMAGE_NAME} || echo "이미지 삭제 실패 또는 이미 삭제됨"
        docker rmi ${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:latest || echo "latest 태그 삭제 실패 또는 이미 삭제됨"
        docker system prune -f || echo "Docker 시스템 정리 실패"
      """
      
      // 워크스페이스 정리
      cleanWs()
    }

    success {
      script {
        if (env.BRANCH in ['main', 'dev']) {
          withCredentials([string(credentialsId: 'Discord-Webhook', variable: 'DISCORD')]) {
            discordSend(
              description: """
              🐳 Docker 빌드 배포 성공!
              제목: ${currentBuild.displayName}
              결과: 성공
              실행 시간: ${currentBuild.duration / 1000}s
              Docker 이미지: ${env.FULL_IMAGE_NAME}
              """.stripIndent(),
              link: env.BUILD_URL,
              title: "${env.JOB_NAME} :: ${env.BRANCH} :: Docker 빌드 성공",
              result: 'SUCCESS',
              webhookURL: DISCORD
            )
          }
        }
      }
    }

    failure {
      script {
        if (env.BRANCH in ['main', 'dev']) {
          withCredentials([string(credentialsId: 'Discord-Webhook', variable: 'DISCORD')]) {
            discordSend(
              description: """
              🐳 Docker 빌드 배포 실패!
              제목: ${currentBuild.displayName}
              결과: 실패
              실행 시간: ${currentBuild.duration / 1000}s
              """.stripIndent(),
              link: env.BUILD_URL,
              title: "${env.JOB_NAME} :: ${env.BRANCH} :: Docker 빌드 실패",
              result: 'FAILURE',
              webhookURL: DISCORD
            )
          }
        }
      }
    }
  }
} 